#!/bin/bash
# chromium based browser installer for termux proot-distro fedora
# only include browser that support arm64

install_deps()
{
dnf install dnf-plugins-core fedora-workstation-repositories -y --setopt=strict=0
}

install_chrome()
{
    rm -f /etc/yum.repos.d/google-chrome.repo
    dnf config-manager addrepo --id=google-chrome --set=baseurl=http://dl.google.com/linux/chrome/rpm/stable/$basearch --set=gpgkey=https://dl.google.com/linux/linux_signing_key.pub --set=gpgcheck=1 --set=repo_gpgcheck=1 --set=priority=10
    dnf makecache
    dnf install google-chrome-stable -y
}

uninstall_chrome()
{
    dnf remove -y google-chrome-stable
    rm -f /etc/yum.repos.d/google-chrome.repo
}

install_brave()
{
    rm -f /etc/yum.repos.d/brave-browser.repo
    dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
    dnf makecache
    dnf install brave-browser -y
}

uninstall_brave()
{
    dnf remove -y brave-browser
    rm -f /etc/yum.repos.d/brave-browser.repo
}

install_braveorigin()
{
    rm -f /etc/yum.repos.d/brave-browser.repo
    dnf config-manager addrepo --from-repofile=https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
    dnf makecache
    dnf install brave-origin -y
}

uninstall_braveorigin()
{
    dnf remove -y brave-origin
    rm -f /etc/yum.repos.d/brave-browser.repo
}

install_vivaldi()
{
    rm -f /etc/yum.repos.d/vivaldi-fedora.repo
    rpm --import https://repo.vivaldi.com/archive/linux_signing_key.pub
    dnf config-manager addrepo --from-repofile=https://repo.vivaldi.com/archive/vivaldi-fedora.repo
    dnf makecache
    dnf install vivaldi-stable -y
}

uninstall_vivaldi()
{
    dnf remove -y vivaldi-stable
    rm -f /etc/yum.repos.d/vivaldi-fedora.repo
}

install_browser_files()
{
    local browser_name=$1
    install -d -m 0755 /usr/local/share/applications
    curl -fsSLo /usr/local/share/applications/${browser_name}-proot.desktop https://raw.githubusercontent.com/arfshl/prootdistro-chromium-installer/refs/heads/main/${browser_name}-proot.desktop && chmod 0644 /usr/local/share/applications/${browser_name}-proot.desktop
}

uninstall_browser_files()
{
    local browser_name=$1
    rm /usr/local/share/applications/${browser_name}-proot.desktop
}

check_installed()
{
    local browser_name=$1
    local pkg_name=""

    case "$browser_name" in
        chrome)      pkg_name="google-chrome-stable" ;;
        brave)       pkg_name="brave-browser" ;;
        braveorigin) pkg_name="brave-origin" ;;
        vivaldi)     pkg_name="vivaldi-stable" ;;
        *)
            echo "Error: Invalid browser '$browser_name'" >&2
            usage
            exit 1
            ;;
    esac

    rpm -q "$pkg_name" &>/dev/null
}

install_browser()
{
    local browser_name=$1

    if check_installed ${browser_name}; then
        echo "${browser_name} already installed" >&2
        exit 1
    fi
    install_deps
    eval install_${browser_name}
    install_browser_files ${browser_name}
}

uninstall_browser()
{
    local browser_name=$1
    eval uninstall_${browser_name}
    uninstall_browser_files ${browser_name}
}

usage()
{
    echo "Usage: $0 install <brave|braveorigin|chrome|vivaldi>"
    echo "       $0 uninstall <brave|braveorigin|chrome|vivaldi>"
    exit 1
}

if [ $(id -u) -ne 0 ]; then
    echo "This script must be run as root" 1>&2
    exit 1
fi

[ $# -eq 0 ] && usage

while [ $# -gt 0 ]; do
    case "$1" in
    install)
        case "$2" in
        brave|braveorigin|chrome|vivaldi)
            browser=$2
            install_browser "$browser"
            exit $?
            ;;
        *)
            usage
            ;;
        esac
        shift 2
        ;;

    uninstall)
        case "$2" in
        brave|braveorigin|chrome|vivaldi)
            browser=$2
            uninstall_browser "$browser"
            exit $?
            ;;
        *)
            usage
            ;;
        esac
        shift 2
        ;;

    *)
        usage
        ;;
    esac
done